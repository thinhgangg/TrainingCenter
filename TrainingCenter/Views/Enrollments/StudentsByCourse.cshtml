@model IEnumerable<TrainingCenter.Models.Enrollment>
@using System.Linq

@{
    ViewBag.Title = "Danh sách học viên";
}

<h2>Khóa học: @ViewBag.CourseName</h2>
<hr />

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="d-flex justify-content-between mb-3">
    <div>
        @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
    </div>
    <div>
        <a href="@Url.Action("Create", "Enrollments", new { courseId = ViewBag.CourseId, returnUrl = Url.Action("StudentsByCourse", "Enrollments", new { id = ViewBag.CourseId }) })" class="btn btn-success">
            <i class="fas fa-user-plus"></i> Thêm học viên
        </a>
    </div>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Họ và tên học viên</th>
            <th>Ngày đăng ký</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="3" class="text-center text-danger">Không có học viên nào đăng ký khóa học này.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Student.FullName</td>
                    <td>@item.RegisterDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a href="@Url.Action("Delete", new { id = item.EnrollmentId })" class="btn btn-sm btn-danger" title="Xóa">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}