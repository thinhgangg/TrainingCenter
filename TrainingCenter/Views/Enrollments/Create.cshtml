@model TrainingCenter.Models.Enrollment

@{
    ViewBag.Title = "Thêm mới đăng ký khóa học";
}

<h2>Thêm mới đăng ký khóa học</h2>
<hr />

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="d-flex justify-content-start mb-3">
    <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index", "Enrollments"))" class="btn btn-secondary">Quay lại</a>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.StudentId, "Học viên", htmlAttributes: new { @class = "control-label col-md-2", style = "font-weight: bold" })
            <div class="col-md-10">
                @Html.DropDownList("StudentId", null, "-- Chọn học viên --", htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.StudentId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.CourseId, "Môn học", htmlAttributes: new { @class = "control-label col-md-2", style = "font-weight: bold" })
            <div class="col-md-10">
                @Html.DropDownList("CourseId", null, "-- Chọn môn học --", htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.CourseId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.HiddenFor(model => model.RegisterDate)
        </div>

        <div class="form-group mt-3">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-success">Tạo mới</button>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}