@model TrainingCenter.Models.Enrollment

@{
    ViewBag.Title = "Thêm mới đăng ký khóa học";
}

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-user-plus me-2"></i> Thêm mới đăng ký khóa học</h4>
                </div>
                <div class="card-body">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <div class="mb-3">
                            @Html.LabelFor(model => model.StudentId, "Học viên", htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("StudentId", null, "-- Chọn học viên --", htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.StudentId, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.CourseId, "Môn học", htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("CourseId", null, "-- Chọn môn học --", htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.CourseId, "", new { @class = "text-danger" })
                        </div>

                        @Html.HiddenFor(model => model.RegisterDate)

                        <div class="d-flex justify-content-between mt-4">
                            <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index", "Enrollments"))" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i> Quay lại
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-check-circle me-2"></i> Tạo mới
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
