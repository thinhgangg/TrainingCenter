@model TrainingCenter.Models.Enrollment

@{
    ViewBag.Title = "Xóa đăng ký khóa học";
}

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4 border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="fas fa-user-times me-2"></i> Xóa đăng ký khóa học</h4>
                </div>

                <div class="card-body">

                    <dl class="row">
                        <dt class="col-sm-4 fw-bold">Khóa học</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Course.CourseName)</dd>

                        <dt class="col-sm-4 fw-bold">Giảng viên</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Course.Instructor)</dd>

                        <dt class="col-sm-4 fw-bold">Học viên</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Student.FullName)</dd>

                        <dt class="col-sm-4 fw-bold">Ngày đăng ký</dt>
                        <dd class="col-sm-8">@Model.RegisterDate.ToString("dd/MM/yyyy")</dd>
                    </dl>

                    <div class="alert alert-warning mt-4">
                        <strong><i class="fas fa-exclamation-triangle me-2"></i>Bạn có chắc chắn muốn xóa đăng ký này?</strong>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash-alt me-1"></i> Xóa
                            </button>
                            @Html.ActionLink("Hủy bỏ", "StudentsByCourse", "Enrollments", new { id = ViewBag.CourseId }, new { @class = "btn btn-outline-secondary" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
