@model TrainingCenter.Models.Enrollment

@{
    ViewBag.Title = "Xóa đăng ký khóa học";
}

<h2>Xóa đăng ký khóa học</h2>

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Khóa học
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Course.CourseName)
        </dd>

        <dt>
            Giảng viên
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Course.Instructor)
        </dd>

        <dt>
            Học viên
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Student.FullName)
        </dd>

        <dt>
            Ngày đăng ký
        </dt>
        <dd>
            @Model.RegisterDate.ToString("dd/MM/yyyy")
        </dd>
    </dl>

    <div class="alert alert-warning">
        <strong>Bạn có chắc chắn muốn xóa đăng ký này?</strong>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-group mt-3">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-danger">Xóa</button>

                @Html.ActionLink("Hủy bỏ", "StudentsByCourse", "Enrollments", new { id = ViewBag.CourseId }, new { @class = "btn btn-secondary" })
            </div>
        </div>
    }
</div>
