<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trung tâm đào tạo</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/custom-alert.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    @{
        bool isAdmin = Session["AdminId"] != null;
        bool isStudent = Session["StudentId"] != null;
    }
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @{
                if (isAdmin)
                {
                    @Html.ActionLink("Trung tâm đào tạo", "Dashboard", "Admins", null, new { @class = "navbar-brand" })
                }
                else if (isStudent)
                {
                    @Html.ActionLink("Trung tâm đào tạo", "Dashboard", "Students", null, new { @class = "navbar-brand" })
                }
                else
                {
                    @Html.ActionLink("Trung tâm đào tạo", "Index", "Home", null, new { @class = "navbar-brand" })
                }
            }

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-end">
                <ul class="navbar-nav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                        </li>
                    }
                    else
                    {
                        if (ViewContext.RouteData.Values["Controller"].ToString() == "Home" && ViewContext.RouteData.Values["Action"].ToString() == "Index")
                        {
                            <li class="nav-item @(ViewContext.RouteData.Values["Action"].ToString() == "Login" && ViewContext.RouteData.Values["Controller"].ToString() == "Account" ? "active" : "")">
                                @Html.ActionLink("Đăng nhập", "Login", "Account", new { area = "" }, new { @class = "nav-link" })
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["Action"].ToString() == "Register" && ViewContext.RouteData.Values["Controller"].ToString() == "Account" ? "active" : "")">
                                @Html.ActionLink("Đăng ký", "Register", "Account", new { area = "" }, new { @class = "nav-link" })
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </nav>
    @if (ViewBag.IsHome != null && ViewBag.IsHome)
    {
        @RenderBody()
        <div class="container body-content">
            <hr />
            <footer>
                <p>© @DateTime.Now.Year - Trung tâm đào tạo</p>
            </footer>
        </div>
    }
    else
    {
        <div class="container body-content">
            @RenderBody()
            <hr />
            <footer>
                <p>© @DateTime.Now.Year - Trung tâm đào tạo</p>
            </footer>
        </div>
    }

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>

<style>
    .full-width-banner {
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .banner-img {
        width: 100%;
        height: auto;
    }
</style>