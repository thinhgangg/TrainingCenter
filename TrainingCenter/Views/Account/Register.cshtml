@model TrainingCenter.Models.Student
@{
    ViewBag.Title = "Đăng ký";
}

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 600px">
    <div class="card shadow-lg rounded-4" style="width: 100%; max-width: 350px;">
        <div class="card-header bg-success text-white text-center">
            <h5 class="mb-0">Đăng ký</h5>
        </div>
        <div class="card-body p-3">

            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-2 small" })

                <div class="mb-2">
                    @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold small" })
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Họ và tên" })
                    </div>
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-2">
                    @Html.LabelFor(m => m.Dob, new { @class = "form-label fw-semibold small" })
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                        @Html.TextBoxFor(m => m.Dob, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Dob, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-2">
                    @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold small" })
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Số điện thoại" })
                    </div>
                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-2">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold small" })
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-2">
                    @Html.LabelFor(m => m.Username, new { @class = "form-label fw-semibold small" })
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Tên người dùng" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold small" })
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mật khẩu" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="fas fa-user-plus me-1"></i> Đăng ký
                </button>
            }

            <p class="text-center mt-3 mb-0 small">
                Đã có tài khoản? @Html.ActionLink("Đăng nhập", "Login", "Account")
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
