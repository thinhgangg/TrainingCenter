@model TrainingCenter.Models.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
}

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 600px">
    <div class="card shadow-lg rounded-4 card-hover-lift" style="width: 100%; max-width: 350px;">
        <div class="card-header bg-primary text-white text-center">
            <h5 class="mb-0">Đăng nhập</h5>
        </div>
        <div class="card-body">

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Username, htmlAttributes: new { @class = "form-label fw-bold" })
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Tên đăng nhập" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, htmlAttributes: new { @class = "form-label fw-bold" })
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mật khẩu" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-primary w-100 mt-3">
                    <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập
                </button>
            }

            <p class="text-center mt-3 mb-0">
                Chưa có tài khoản? @Html.ActionLink("Đăng ký", "Register", "Account")
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<style>
    .card-hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card-hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
    }
</style>
