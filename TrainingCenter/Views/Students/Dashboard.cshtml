@model TrainingCenter.Models.DashboardViewModel

@{
    ViewBag.Title = "Trung tâm đào tạo";
}

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">👋 Chào mừng, @Model.Student.FullName!</h3>
        <div class="dropdown">
            <button class="btn btn-outline-dark dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-user-circle me-1"></i> Tài khoản
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                <li><a class="dropdown-item" href="@Url.Action("Edit", "Students", new { id = Model.Student.StudentId })"><i class="fas fa-user-edit me-2"></i> Thay đổi thông tin</a></li>
                <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</a></li>
            </ul>
        </div>
    </div>

    <!-- KHÓA HỌC ĐÃ ĐĂNG KÝ -->
    <div class="card mb-4 shadow-sm rounded-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i> Khóa học đã đăng ký</h5>
        </div>
        <div class="card-body">
            @if (Model.EnrolledCourses != null && Model.EnrolledCourses.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover text-center align-middle">
                        <colgroup>
                            <col style="width: 30%;">
                            <col style="width: 20%;">
                            <col style="width: 15%;">
                            <col style="width: 15%;">
                            <col style="width: 10%;">
                            <col style="width: 10%;">
                        </colgroup>
                        <thead class="table-light">
                            <tr>
                                <th>Tên khóa học</th>
                                <th>Giảng viên</th>
                                <th>Ngày bắt đầu</th>
                                <th>Học phí</th>
                                <th>Số lượng</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.EnrolledCourses)
                            {
                                <tr>
                                    <td>@item.Course.CourseName</td>
                                    <td>@item.Course.Instructor</td>
                                    <td>@item.Course.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@String.Format("{0:N0} VNĐ", item.Course.Fee)</td>
                                    <td>@item.EnrolledCount / @(item.Course.MaxStudents?.ToString() ?? "Không giới hạn")</td>
                                    <td>
                                        <form action="@Url.Action("CancelEnrollment", "Enrollments", new { courseId = item.Course.CourseId, studentId = Model.Student.StudentId })" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy đăng ký">
                                                <i class="fas fa-times-circle"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center mb-0">Bạn chưa đăng ký khóa học nào.</p>
            }
        </div>
    </div>

    <!-- KHÓA HỌC ĐANG MỞ -->
    <div class="card shadow-sm rounded-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-book-open me-2"></i> Khóa học đang mở đăng ký</h5>
        </div>
        <div class="card-body">
            @if (Model.OpenCourses != null && Model.OpenCourses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover text-center align-middle">
                        <colgroup>
                            <col style="width: 30%;">
                            <col style="width: 20%;">
                            <col style="width: 15%;">
                            <col style="width: 15%;">
                            <col style="width: 10%;">
                            <col style="width: 10%;">
                        </colgroup>
                        <thead class="table-light">
                            <tr>
                                <th>Tên khóa học</th>
                                <th>Giảng viên</th>
                                <th>Ngày bắt đầu</th>
                                <th>Học phí</th>
                                <th>Số lượng</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OpenCourses)
                            {
                                <tr>
                                    <td>@item.Course.CourseName</td>
                                    <td>@item.Course.Instructor</td>
                                    <td>@item.Course.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@String.Format("{0:N0} VNĐ", item.Course.Fee)</td>
                                    <td>@item.EnrolledCount / @(item.Course.MaxStudents?.ToString() ?? "Không giới hạn")</td>
                                    <td>
                                        @if (Model.Student != null)
                                        {
                                            <form action="@Url.Action("Register", "Enrollments", new { courseId = item.Course.CourseId })" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="studentId" value="@Model.Student.StudentId" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Đăng ký">
                                                    <i class="fas fa-plus-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Vui lòng đăng nhập lại.</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center mb-0">Hiện tại không có khóa học nào đang mở đăng ký.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
