@model TrainingCenter.Models.DashboardViewModel

@{
    ViewBag.Title = "Trung tâm đào tạo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Chào mừng, @Model.Student.FullName!</h2>
    <div class="dropdown">
        <button class="btn btn-light" type="button" id="userDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fas fa-user"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
            <a class="dropdown-item" href="@Url.Action("Edit", "Students", new { id = Model.Student.StudentId })">Thay đổi thông tin</a>
            <a class="dropdown-item" href="@Url.Action("Logout", "Account")">Đăng xuất</a>
        </div>
    </div>
</div>
<hr />

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<h4>Danh sách khóa học đã đăng ký:</h4>
@if (Model.EnrolledCourses != null && Model.EnrolledCourses.Count > 0)
{
    <table class="table table-bordered table-hover align-middle">
        <colgroup>
            <col style="width: 30%;">
            <col style="width: 20%;">
            <col style="width: 15%;">
            <col style="width: 15%;">
            <col style="width: 10%;">
            <col style="width: 10%;">
        </colgroup>
        <thead>
            <tr class="text-center">
                <th>Tên khóa học</th>
                <th>Giảng viên</th>
                <th>Ngày bắt đầu</th>
                <th>Học phí</th>
                <th>Số lượng</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.EnrolledCourses)
            {
                <tr>
                    <td>@item.Course.CourseName</td>
                    <td>@item.Course.Instructor</td>
                    <td class="text-center">@item.Course.StartDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">@String.Format("{0:N0} VNĐ", item.Course.Fee)</td>
                    <td class="text-center">@item.EnrolledCount / @(item.Course.MaxStudents.HasValue ? item.Course.MaxStudents.Value.ToString() : "Không giới hạn")</td>
                    <td class="text-center">
                        <form action="@Url.Action("CancelEnrollment", "Enrollments", new { courseId = item.Course.CourseId, studentId = Model.Student.StudentId })" method="post" style="display:inline-block;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy đăng ký">
                                <i class="fas fa-times-circle fa-lg"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-center">Bạn chưa đăng ký khóa học nào.</p>
}

<h4>Danh sách khóa học đang mở đăng ký:</h4>
@if (Model.OpenCourses != null && Model.OpenCourses.Any())
{
    <table class="table table-bordered table-hover align-middle">
        <colgroup>
            <col style="width: 30%;">
            <col style="width: 20%;">
            <col style="width: 15%;">
            <col style="width: 15%;">
            <col style="width: 10%;">
            <col style="width: 10%;">
        </colgroup>
        <thead>
            <tr class="text-center">
                <th>Tên khóa học</th>
                <th>Giảng viên</th>
                <th>Ngày bắt đầu</th>
                <th>Học phí</th>
                <th>Số lượng</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OpenCourses)
            {
                <tr>
                    <td>@item.Course.CourseName</td>
                    <td>@item.Course.Instructor</td>
                    <td class="text-center">@item.Course.StartDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">@String.Format("{0:N0} VNĐ", item.Course.Fee)</td>
                    <td class="text-center">@item.EnrolledCount / @(item.Course.MaxStudents.HasValue ? item.Course.MaxStudents.Value.ToString() : "Không giới hạn")</td>
                    <td class="text-center">
                        @if (Model.Student != null)
                        {
                            <form action="@Url.Action("Register", "Enrollments", new { courseId = item.Course.CourseId })" method="post" style="display:inline-block;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="studentId" value="@Model.Student.StudentId" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Đăng ký">
                                    <i class="fas fa-plus-circle fa-lg"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-danger">Vui lòng đăng nhập lại.</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-center">Hiện tại không có khóa học nào đang mở đăng ký.</p>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
}
