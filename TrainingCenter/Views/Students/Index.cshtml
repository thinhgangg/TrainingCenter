@model IEnumerable<TrainingCenter.Models.Student>

@{
    ViewBag.Title = "Danh sách học viên";
}

<h2>Danh sách học viên</h2>
<hr />

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="d-flex justify-content-between mb-3">
    <div>
        @Html.ActionLink("Quay lại", "Dashboard", "Admins", null, new { @class = "btn btn-secondary" })
    </div>
    <div>
        <a href="@Url.Action("Create", "Students")" class="btn btn-success"><i class="fas fa-user-plus"></i> Thêm học viên</a>
    </div>
</div>

<table class="table table-hover align-middle">
    <tr>
        <th>@Html.DisplayNameFor(model => model.FullName)</th>
        <th>@Html.DisplayNameFor(model => model.Dob)</th>
        <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
        <th>@Html.DisplayNameFor(model => model.Email)</th>
        <th>@Html.DisplayNameFor(model => model.Username)</th>
        <th>@Html.DisplayNameFor(model => model.Password)</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.FullName)</td>
            <td>@item.Dob.ToString("dd/MM/yyyy")</td>   
            <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
            <td>@Html.DisplayFor(modelItem => item.Email)</td>
            <td>@Html.DisplayFor(modelItem => item.Username)</td>
            <td><span class="text-muted">••••••</span></td>
            <td class="text-center">
                <div class="d-flex justify-content-center gap-1">
                    <a href="@Url.Action("Edit", new { id = item.StudentId })" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="@Url.Action("Details", new { id = item.StudentId })" class="btn btn-sm btn-outline-info" title="Chi tiết">
                        <i class="fas fa-info-circle"></i>
                    </a>
                    <a href="@Url.Action("Delete", new { id = item.StudentId })" class="btn btn-sm btn-outline-danger" title="Xóa" onclick="return confirm('Bạn có chắc chắn muốn xóa học viên này?');">
                        <i class="fas fa-trash-alt"></i>
                    </a>
                </div>
            </td>
        </tr>
    }
</table>
