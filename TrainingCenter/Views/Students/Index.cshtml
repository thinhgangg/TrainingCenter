@model IEnumerable<TrainingCenter.Models.Student>

@{
    ViewBag.Title = "Danh sách học viên";
}

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-4">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-users me-2"></i> Danh sách học viên</h4>
            <a href="@Url.Action("Create", "Students")" class="btn btn-light btn-sm">
                <i class="fas fa-user-plus"></i> Thêm học viên
            </a>
        </div>

        <div class="card-body">

            <div class="mb-3">
                @Html.ActionLink("← Quay lại bảng điều khiển", "Dashboard", "Admins", null, new { @class = "btn btn-outline-secondary btn-sm" })
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>STT</th>
                            <th>@Html.DisplayNameFor(model => model.First().FullName)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Dob)</th>
                            <th>@Html.DisplayNameFor(model => model.First().PhoneNumber)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Email)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Username)</th>
                            <th>Mật khẩu</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@stt</td>
                                <td class="text-start">@item.FullName</td>
                                <td>@item.Dob.ToString("dd/MM/yyyy")</td>
                                <td>@item.PhoneNumber</td>
                                <td class="text-start">@item.Email</td>
                                <td>@item.Username</td>
                                <td><span class="text-muted">••••••</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="@Url.Action("Edit", new { id = item.StudentId })" class="btn btn-outline-primary" title="Chỉnh sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Details", new { id = item.StudentId })" class="btn btn-outline-info" title="Chi tiết">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.StudentId })" class="btn btn-outline-danger">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
