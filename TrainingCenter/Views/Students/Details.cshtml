@model TrainingCenter.Models.Student

@{
    ViewBag.Title = "Thông tin học viên";
}

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm rounded-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-user-graduate me-2"></i> Thông tin học viên</h4>
                </div>

                <div class="card-body">

                    <dl class="row">
                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.FullName)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.FullName)</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.Dob)</dt>
                        <dd class="col-sm-8">@Model.Dob.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.PhoneNumber)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.PhoneNumber)</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.Email)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.Username)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Username)</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(model => model.Password)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Password)</dd>
                    </dl>

                    <div class="d-flex justify-content-between mt-4">
                        @Html.ActionLink("← Quay lại", "Index", null, new { @class = "btn btn-outline-secondary" })
                        @Html.ActionLink("Xem khóa học đã đăng ký", "CoursesByStudent", "Enrollments", new { id = Model.StudentId }, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
