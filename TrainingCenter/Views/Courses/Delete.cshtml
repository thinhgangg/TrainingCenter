@model TrainingCenter.Models.Course

@{
    ViewBag.Title = "Xóa khóa học";
}

<h2>Xóa khóa học</h2>

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.CourseName)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CourseName)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Instructor)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Instructor)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>

        <dd>
            @Model.StartDate.ToString("dd/MM/yyyy")
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Fee)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Fee)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.MaxStudents)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.MaxStudents)
        </dd>

    </dl>

    <div class="alert alert-warning">
        <strong>Bạn có chắc chắn muốn xóa khóa học này?</strong>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-group mt-3">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Xóa" class="btn btn-danger" />

                @Html.ActionLink("Hủy bỏ", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    }
</div>