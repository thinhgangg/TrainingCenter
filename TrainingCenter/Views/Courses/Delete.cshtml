@model TrainingCenter.Models.Course

@{
    ViewBag.Title = "Xóa khóa học";
}

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4 border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="fas fa-trash-alt me-2"></i> Xóa khóa học</h4>
                </div>

                <div class="card-body">

                    <dl class="row">
                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.CourseName)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.CourseName)</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.Instructor)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.Instructor)</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.StartDate)</dt>
                        <dd class="col-sm-8">@Model.StartDate.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.Fee)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.Fee)</dd>

                        <dt class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.MaxStudents)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.MaxStudents)</dd>
                    </dl>

                    <div class="alert alert-warning mt-4">
                        <strong><i class="fas fa-exclamation-triangle me-2"></i>Bạn có chắc chắn muốn xóa khóa học này?</strong>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <input type="submit" value="Xóa" class="btn btn-danger px-4" />
                            @Html.ActionLink("Hủy bỏ", "Index", null, new { @class = "btn btn-outline-secondary" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
