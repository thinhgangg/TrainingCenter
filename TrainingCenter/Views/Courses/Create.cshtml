@model TrainingCenter.Models.Course

@{
    ViewBag.Title = "Tạo khóa học";
}

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i> Tạo khóa học</h4>
                </div>
                <div class="card-body">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CourseName, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(m => m.CourseName, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên khóa học" } })
                            @Html.ValidationMessageFor(m => m.CourseName, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Instructor, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(m => m.Instructor, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên giảng viên" } })
                            @Html.ValidationMessageFor(m => m.Instructor, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.StartDate, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Fee, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(m => m.Fee, new { htmlAttributes = new { @class = "form-control", type = "number", step = "1000", placeholder = "VD: 2000000" } })
                            @Html.ValidationMessageFor(m => m.Fee, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.MaxStudents, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(m => m.MaxStudents, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1", max = "100" } })
                            @Html.ValidationMessageFor(m => m.MaxStudents, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            @Html.ActionLink("← Quay lại", "Index", null, new { @class = "btn btn-outline-secondary" })
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-check-circle me-2"></i> Tạo mới
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
