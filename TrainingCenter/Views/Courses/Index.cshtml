@model IEnumerable<TrainingCenter.Models.Course>

@{
    ViewBag.Title = "Danh sách khóa học";
}

<h2>Danh sách khóa học</h2>
<hr />

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="d-flex justify-content-between mb-3">
    <div>
        @Html.ActionLink("Quay lại", "Dashboard", "Admins", null, new { @class = "btn btn-secondary" })
    </div>
    <div>
        <a href="@Url.Action("Create", "Courses")" class="btn btn-success"><i class="fas fa-plus"></i> Thêm khóa học</a>
    </div>
</div>

<table class="table table-hover align-middle">
    <tr>
        <th>@Html.DisplayNameFor(model => model.CourseName)</th>
        <th>@Html.DisplayNameFor(model => model.Instructor)</th>
        <th>@Html.DisplayNameFor(model => model.StartDate)</th>
        <th>@Html.DisplayNameFor(model => model.Fee)</th>
        <th>@Html.DisplayNameFor(model => model.MaxStudents)</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.CourseName)</td>
            <td>@Html.DisplayFor(modelItem => item.Instructor)</td>
            <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
            <td>@String.Format("{0:N0} VNĐ", item.Fee)</td>
            <td>@Html.DisplayFor(modelItem => item.MaxStudents)</td>
            <td class="text-center">
                <div class="d-flex justify-content-center gap-1">
                    <a href="@Url.Action("Edit", new { id = item.CourseId })" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="@Url.Action("Details", new { id = item.CourseId })" class="btn btn-sm btn-outline-info" title="Chi tiết">
                        <i class="fas fa-info-circle"></i>
                    </a>
                    <a href="@Url.Action("Delete", new { id = item.CourseId })" class="btn btn-sm btn-outline-danger" title="Xóa"
                       onclick="return confirm('Bạn có chắc chắn muốn xóa khóa học này?');">
                        <i class="fas fa-trash-alt"></i>
                    </a>
                </div>
            </td>


        </tr>
    }
</table>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}