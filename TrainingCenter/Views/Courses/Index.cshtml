@model IEnumerable<TrainingCenter.Models.Course>

@{
    ViewBag.Title = "Danh sách khóa học";
}

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-book me-2"></i> Danh sách khóa học</h4>
            <a href="@Url.Action("Create", "Courses")" class="btn btn-light btn-sm">
                <i class="fas fa-plus"></i> Thêm khóa học
            </a>
        </div>

        <div class="card-body">

            <div class="mb-3">
                @Html.ActionLink("← Quay lại bảng điều khiển", "Dashboard", "Admins", null, new { @class = "btn btn-outline-secondary btn-sm" })
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>STT</th>
                            <th>@Html.DisplayNameFor(model => model.First().CourseName)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Instructor)</th>
                            <th>@Html.DisplayNameFor(model => model.First().StartDate)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Fee)</th>
                            <th>@Html.DisplayNameFor(model => model.First().MaxStudents)</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@stt</td>
                                <td class="text-start">@Html.DisplayFor(modelItem => item.CourseName)</td>
                                <td class="text-start">@Html.DisplayFor(modelItem => item.Instructor)</td>
                                <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@String.Format("{0:N0} VNĐ", item.Fee)</td>
                                <td>@Html.DisplayFor(modelItem => item.MaxStudents)</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="@Url.Action("Edit", new { id = item.CourseId })" class="btn btn-outline-primary" title="Chỉnh sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Details", new { id = item.CourseId })" class="btn btn-outline-info" title="Chi tiết">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.CourseId })" class="btn btn-outline-danger" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
