@model IEnumerable<TrainingCenter.Models.ViewModels.RevenueFilterViewModel>

@{
    ViewBag.Title = "Doanh thu theo tháng";
    var month = ViewBag.SelectedMonth;
    var year = ViewBag.SelectedYear;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary"><i class="fas fa-calendar-alt me-2"></i> Thống kê doanh thu theo tháng</h3>
        @Html.ActionLink("← Quay lại bảng điều khiển", "Dashboard", "Admins", null, new { @class = "btn btn-outline-secondary btn-sm" })
    </div>

    <hr />

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-2">
            <label for="month" class="form-label">Tháng</label>
            <select name="month" class="form-select" id="month">
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" @(i == month ? "selected" : "")>Tháng @i</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label for="year" class="form-label">Năm</label>
            <select name="year" class="form-select" id="year">
                @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                {
                    <option value="@y" @(y == year ? "selected" : "")>@y</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary mt-3"><i class="fas fa-filter me-1"></i> Lọc</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">Không có dữ liệu doanh thu trong tháng này.</div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <table class="table table-bordered table-hover text-center align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>STT</th>
                            <th>Tên khóa học</th>
                            <th>Học phí</th>
                            <th>Số học viên</th>
                            <th>Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td class="text-start">@item.CourseName</td>
                                    <td><span>@item.Fee.ToString("N0") VNĐ</span></td>
                                    <td><span>@item.StudentCount</span></td>
                                    <td><span class="fw-bold">@item.Revenue.ToString("N0") VNĐ</span></td>
                                </tr>
                                stt++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-secondary fw-bold">
                            <td colspan="4" class="text-end">Tổng doanh thu:</td>
                            <td class="fw-bold text-success">@ViewBag.TotalRevenue.ToString("N0") VNĐ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</div>
