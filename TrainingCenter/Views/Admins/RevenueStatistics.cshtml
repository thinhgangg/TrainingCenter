@model IEnumerable<TrainingCenter.Models.ViewModels.RevenueStatisticViewModel>

@{
    ViewBag.Title = "Thống kê doanh thu";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary"><i class="fas fa-chart-line me-2"></i> Thống kê doanh thu theo khóa học</h3>
        @Html.ActionLink("← Quay lại bảng điều khiển", "Dashboard", "Admins", null, new { @class = "btn btn-outline-secondary btn-sm" })
    </div>

    <hr />

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Tên khóa học</th>
                        <th>Học phí</th>
                        <th>Số học viên</th>
                        <th>Doanh thu</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@stt</td>
                                <td class="text-start">@item.CourseName</td>
                                <td><span>@item.Fee.ToString("N0") VNĐ</span></td>
                                <td><span>@item.StudentCount</span></td>
                                <td><span class="fw-bold">@item.Revenue.ToString("N0") VNĐ</span></td>
                            </tr>
                            stt++;
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="table-secondary fw-bold">
                        <td colspan="4" class="text-end">Tổng doanh thu:</td>
                        <td class="fw-bold text-success">@ViewBag.TotalRevenue.ToString("N0") VNĐ</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
