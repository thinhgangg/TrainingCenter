@model TrainingCenter.Models.AdminDashboardViewModel

@{
    ViewBag.Title = "Bảng điều khiển Admin";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Bảng điều khiển Admin</h2>
    <div class="dropdown">
        <button class="btn btn-light" type="button" id="userDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fas fa-user"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
            @*<a class="dropdown-item" href="@Url.Action("Edit", "Admin", new { id = Model.Admin.AdminId })">Thay đổi thông tin</a>*@
            <a class="dropdown-item" href="@Url.Action("Logout", "Account")">Đăng xuất</a>
        </div>
    </div>
</div>
<hr />

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="row">
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body">
                <h5>Số học viên</h5>
                <p>@Model.StudentCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body">
                <h5>Số khóa học</h5>
                <p>@Model.CourseCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body">
                <h5>Số đăng ký</h5>
                <p>@Model.EnrollmentCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body">
                <h5>Khóa học đang mở</h5>
                <p>@Model.OpenCourses</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <h3>Quản lý</h3>
    <div class="list-group">
        @Html.ActionLink("Quản lý học viên", "Index", "Students", null, new { @class = "list-group-item list-group-item-action" })
        @Html.ActionLink("Quản lý khóa học", "Index", "Courses", null, new { @class = "list-group-item list-group-item-action" })
        @Html.ActionLink("Quản lý đăng ký", "Index", "Enrollments", null, new { @class = "list-group-item list-group-item-action" })
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
}