@model TrainingCenter.Models.AdminDashboardViewModel

@{
    ViewBag.Title = "Bảng điều khiển Admin";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Bảng điều khiển Admin</h2>
    <div class="dropdown">
        <button class="btn btn-outline-dark dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-user-circle me-1"></i> Tài khoản
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
            <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</a></li>
        </ul>
    </div>
</div>
<hr />

@if (TempData["Message"] != null)
{
    <div class="custom-alert custom-alert-@TempData["MessageType"]">@TempData["Message"]</div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3 text-white">
    <div class="col">
        <div class="card bg-primary shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-user-graduate fa-2x mb-2"></i>
                <h6 class="card-title">Học viên</h6>
                <h4>@Model.StudentCount</h4>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card bg-success shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-book-open fa-2x mb-2"></i>
                <h6 class="card-title">Khóa học</h6>
                <h4>@Model.CourseCount</h4>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card bg-warning shadow-sm text-center text-dark">
            <div class="card-body">
                <i class="fas fa-file-signature fa-2x mb-2"></i>
                <h6 class="card-title">Đăng ký</h6>
                <h4>@Model.EnrollmentCount</h4>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card bg-info shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-door-open fa-2x mb-2"></i>
                <h6 class="card-title">Đang mở</h6>
                <h4>@Model.OpenCourses</h4>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card bg-secondary shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-lock fa-2x mb-2"></i>
                <h6 class="card-title">Đã bắt đầu / hết hạn</h6>
                <h4>@Model.ClosedCourses</h4>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <h3>Quản lý</h3>
    <div class="row">
        <div class="col-md-4 mb-3">
            <a href="@Url.Action("Index", "Students")" class="text-decoration-none text-dark">
                <div class="card text-center shadow-sm h-100 border-primary card-hover-lift">
                    <div class="card-body">
                        <i class="fas fa-user-graduate fa-2x mb-2 text-primary"></i>
                        <h5 class="card-title">Học viên</h5>
                        <p class="card-text small text-muted">Xem và chỉnh sửa danh sách học viên.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4 mb-3">
            <a href="@Url.Action("Index", "Courses")" class="text-decoration-none text-dark">
                <div class="card text-center shadow-sm h-100 border-success card-hover-lift">
                    <div class="card-body">
                        <i class="fas fa-book-open fa-2x mb-2 text-success"></i>
                        <h5 class="card-title">Khóa học</h5>
                        <p class="card-text small text-muted">Quản lý thông tin các khóa học.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4 mb-3">
            <a href="@Url.Action("Index", "Enrollments")" class="text-decoration-none text-dark">
                <div class="card text-center shadow-sm h-100 border-danger card-hover-lift">
                    <div class="card-body">
                        <i class="fas fa-file-signature fa-2x mb-2 text-danger"></i>
                        <h5 class="card-title">Đăng ký</h5>
                        <p class="card-text small text-muted">Xem và quản lý các lượt đăng ký.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<div class="mt-4">
    <h3 class="mb-3">Thống kê</h3>
    <div class="row">
        <div class="col-md-4 mb-3">
            <a href="@Url.Action("RevenueStatistics", "Admins")" class="text-decoration-none text-dark">
                <div class="card text-center shadow-sm h-100 border-primary card-hover-lift">
                    <div class="card-body">
                        <i class="fas fa-chart-line fa-2x mb-2 text-primary"></i>
                        <h5 class="card-title">Doanh thu tổng thể</h5>
                        <p class="card-text small text-muted">Xem tổng doanh thu theo từng khóa học.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4 mb-3">
            <a href="@Url.Action("StudentCountStatistics", "Admins")" class="text-decoration-none text-dark">
                <div class="card text-center shadow-sm h-100 border-info card-hover-lift">
                    <div class="card-body">
                        <i class="fas fa-users fa-2x mb-2 text-info"></i>
                        <h5 class="card-title">Số lượng học viên</h5>
                        <p class="card-text small text-muted">Thống kê số lượng học viên theo từng khóa học.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4 mb-3">
            <a href="@Url.Action("RevenueByMonth", "Admins")" class="text-decoration-none text-dark">
                <div class="card text-center shadow-sm h-100 border-warning card-hover-lift">
                    <div class="card-body">
                        <i class="fas fa-calendar-alt fa-2x mb-2 text-warning"></i>
                        <h5 class="card-title">Doanh thu theo thời gian</h5>
                        <p class="card-text small text-muted">Xem doanh thu theo tháng và năm.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}

<style>
    .card-hover-lift {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .card-hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }
</style>
